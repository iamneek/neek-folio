---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { BLOG } from "@consts";

const data = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => {
    if (a.data.pin && !b.data.pin) return -1;
    if (!a.data.pin && b.data.pin) return 1;
    return b.data.date.valueOf() - a.data.date.valueOf();
  });

const pinnedPosts = data.filter(post => post.data.pin);
const unpinnedPosts = data.filter(post => !post.data.pin);
  
type Acc = {
  [year: string]: CollectionEntry<"blog">[];
}

const posts = data.reduce((acc: Acc, post) => {
    const year = post.data.date.getFullYear().toString();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(post);
    return acc;
  }, {});

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));
const allTags = [...new Set(data.flatMap(post => post.data.tags || []))].sort();
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="flex items-center justify-between">
        <h1 class="animate font-semibold text-black dark:text-white">
          Blog
        </h1>
        
        {allTags.length > 0 && (
          <div class="animate flex items-center gap-2" data-all-tags={JSON.stringify(allTags)}>
            <button 
              id="search-toggle"
              class="flex items-center gap-2 px-3 py-2 text-sm rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              title="Search"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
              </svg>
              <span class="hidden sm:inline font-medium">Search</span>
            </button>
            <button 
              id="filter-toggle"
              class="flex items-center gap-2 px-3 py-2 text-sm rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              title="Filter by tags"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
              </svg>
              <span class="hidden sm:inline font-medium">Filters</span>
              <span id="filter-count" class="hidden text-xs px-1.5 py-0.5 rounded-full bg-black/10 dark:bg-white/20"></span>
            </button>
          </div>
        )}
      </div>
      
      <div id="blog-list" class="space-y-4">
        {years.map((year, yearIndex) => (
          <section class="animate space-y-4 year-section" data-year={year}>
            <div class="font-semibold text-black dark:text-white year-header">
              {year}
            </div>
            <div>
              <ul class="flex flex-col gap-4">
                {
                  posts[year].map((post, postIndex) => {
                    const isPinned = post.data.pin;
                    const nextPost = posts[year][postIndex + 1];
                    const showSeparator = isPinned && nextPost && !nextPost.data.pin;
                    
                    return (
                      <>
                        <li data-tags={JSON.stringify(post.data.tags || [])}>
                          <ArrowCard entry={post} showPin={true}/>
                        </li>
                        {showSeparator && (
                          <li class="separator border-t border-black/10 dark:border-white/25"></li>
                        )}
                      </>
                    );
                  })
                }
              </ul>
            </div>
          </section>
        ))}
      </div>
    </div>
  </Container>
</PageLayout>



<script>
let abortController: AbortController | null = null;
let activeDropdown: HTMLElement | null = null;
let activeSearch: HTMLElement | null = null;

function cleanup() {
  if (activeDropdown) {
    activeDropdown.remove();
    activeDropdown = null;
  }
  if (activeSearch) {
    activeSearch.remove();
    activeSearch = null;
  }
  if (abortController) {
    abortController.abort();
    abortController = null;
  }
}

document.addEventListener('astro:before-swap', cleanup);

document.addEventListener('astro:page-load', () => {
  cleanup();

  const blogList = document.getElementById('blog-list');
  const searchToggle = document.getElementById('search-toggle');
  const filterToggle = document.getElementById('filter-toggle');
  const filterParent = filterToggle?.closest('[data-all-tags]');
  const filterCount = document.getElementById('filter-count');

  if (!blogList || !searchToggle || !filterToggle || !filterParent) return;

  abortController = new AbortController();
  const { signal } = abortController;

  const activeTags = new Set<string>();
  let searchQuery = '';

  function onClick(e: MouseEvent) {
    const target = e.target as Node;
    if (activeDropdown && !activeDropdown.contains(target) && !filterToggle?.contains(target)) {
      activeDropdown.remove();
      activeDropdown = null;
    }
    if (activeSearch && !activeSearch.contains(target) && !searchToggle?.contains(target)) {
      activeSearch.remove();
      activeSearch = null;
    }
  }

  function onKeyDown(e: KeyboardEvent) {
    if (e.key === 'Escape') {
      if (activeDropdown) {
        activeDropdown.remove();
        activeDropdown = null;
      }
      if (activeSearch) {
        activeSearch.remove();
        activeSearch = null;
      }
    }
  }

  document.addEventListener('click', onClick, { signal });
  document.addEventListener('keydown', onKeyDown, { signal });

  searchToggle.addEventListener('click', (e) => {
    e.stopPropagation();
    if (activeSearch) {
      activeSearch.remove();
      activeSearch = null;
      return;
    }
    if (activeDropdown) {
      activeDropdown.remove();
      activeDropdown = null;
    }
    showSearch();
  }, { signal });

  filterToggle.addEventListener('click', (e) => {
    e.stopPropagation();
    if (activeDropdown) {
      activeDropdown.remove();
      activeDropdown = null;
      return;
    }
    if (activeSearch) {
      activeSearch.remove();
      activeSearch = null;
    }
    showDropdown();
  }, { signal });

  function showSearch() {
    const rect = searchToggle!.getBoundingClientRect();
    const isDark = document.documentElement.classList.contains('dark');

    const searchEl = document.createElement('div');
    activeSearch = searchEl;
    searchEl.style.cssText = `
      position: fixed;
      top: ${rect.bottom + 8}px;
      right: ${window.innerWidth - rect.right}px;
      width: 256px;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid ${isDark ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.15)'};
      background-color: ${isDark ? '#1c1917' : '#f5f5f4'};
      box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
      z-index: 9999;
      pointer-events: auto;
      box-sizing: border-box;
    `;

    const input = document.createElement('input');
    input.placeholder = 'Search posts...';
    input.value = searchQuery;
    input.style.cssText = `
      width: 100%;
      padding: 6px 12px;
      font-size: 14px;
      border-radius: 4px;
      border: 1px solid ${isDark ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.15)'};
      background-color: ${isDark ? '#000' : '#fff'};
      color: ${isDark ? '#fff' : '#000'};
      outline: none;
      box-sizing: border-box;
    `;

    input.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
      filterPosts();
    });

    searchEl.appendChild(input);
    document.body.appendChild(searchEl);
    input.focus();
  }

  function showDropdown() {
    const rect = filterToggle!.getBoundingClientRect();
    const isDark = document.documentElement.classList.contains('dark');
    const allTags: string[] = JSON.parse(filterParent!.getAttribute('data-all-tags') || '[]');

    const dropdownEl = document.createElement('div');
    activeDropdown = dropdownEl;
    dropdownEl.style.cssText = `
      position: fixed;
      top: ${rect.bottom + 8}px;
      right: ${window.innerWidth - rect.right}px;
      width: 256px;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid ${isDark ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.15)'};
      background-color: ${isDark ? '#1c1917' : '#f5f5f4'};
      box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
      z-index: 9999;
      pointer-events: auto;
      box-sizing: border-box;
    `;

    const input = document.createElement('input');
    input.placeholder = 'Search tags...';
    input.style.cssText = `
      width: 100%;
      padding: 6px 12px;
      font-size: 14px;
      border-radius: 4px;
      border: 1px solid ${isDark ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.15)'};
      background-color: ${isDark ? '#000' : '#fff'};
      color: ${isDark ? '#fff' : '#000'};
      outline: none;
      box-sizing: border-box;
    `;

    const listContainer = document.createElement('div');
    listContainer.style.cssText = `max-height: 192px; overflow-y: auto; margin-top: 8px;`;

    const checkboxes: HTMLInputElement[] = [];

    allTags.forEach(tag => {
      const label = document.createElement('label');
      label.style.cssText = `
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 8px;
        font-size: 14px;
        border-radius: 4px;
        cursor: pointer;
        color: ${isDark ? 'rgba(255,255,255,0.75)' : 'rgba(0,0,0,0.75)'};
        transition: background-color 0.15s;
      `;
      label.addEventListener('mouseenter', () => { label.style.backgroundColor = isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)'; });
      label.addEventListener('mouseleave', () => { label.style.backgroundColor = 'transparent'; });

      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      if (activeTags.has(tag)) checkbox.checked = true;

      checkbox.addEventListener('change', () => {
        if (checkbox.checked) {
          activeTags.add(tag);
        } else {
          activeTags.delete(tag);
        }
        filterPosts();
        updateUI();
      });

      const span = document.createElement('span');
      span.textContent = tag;

      label.appendChild(checkbox);
      label.appendChild(span);
      listContainer.appendChild(label);
      checkboxes.push(checkbox);
    });

    input.addEventListener('input', () => {
      const query = input.value.toLowerCase();
      listContainer.querySelectorAll('label').forEach(label => {
        const text = label.querySelector('span')?.textContent?.toLowerCase() || '';
        label.style.display = text.includes(query) ? 'flex' : 'none';
      });
    });

    dropdownEl.appendChild(input);
    dropdownEl.appendChild(listContainer);

    if (activeTags.size > 0) {
      const clearBtn = document.createElement('button');
      clearBtn.textContent = 'Clear all';
      clearBtn.style.cssText = `
        width: 100%;
        margin-top: 8px;
        padding: 6px 12px;
        font-size: 14px;
        border-radius: 4px;
        border: none;
        background-color: ${isDark ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.1)'};
        cursor: pointer;
        color: inherit;
      `;
      clearBtn.addEventListener('click', () => {
        activeTags.clear();
        checkboxes.forEach(cb => cb.checked = false);
        filterPosts();
        updateUI();
        clearBtn.remove();
      });
      dropdownEl.appendChild(clearBtn);
    }

    document.body.appendChild(dropdownEl);
    input.focus();
  }

  function fuzzyMatch(text: string, query: string) {
    if (!query) return true;
    text = text.toLowerCase();
    let textIndex = 0;
    for (let i = 0; i < query.length; i++) {
      textIndex = text.indexOf(query[i], textIndex);
      if (textIndex === -1) return false;
      textIndex++;
    }
    return true;
  }

  function filterPosts() {
    const sections = blogList?.querySelectorAll<HTMLElement>('.year-section');
    if (!sections) return;

    sections.forEach(section => {
      const items = section.querySelectorAll<HTMLElement>('li');
      let visibleCount = 0;

      items.forEach(item => {
        if (item.classList.contains('separator')) {
          item.classList.add('hidden');
          return;
        }

        const tagsAttr = item.getAttribute('data-tags');
        const link = item.querySelector('a');
        const title = link?.querySelector('.font-semibold')?.textContent || '';
        const description = link?.querySelector('.text-sm')?.textContent || '';

        let matchesSearch = true;
        if (searchQuery) {
          const searchText = `${title} ${description} ${tagsAttr || ''}`;
          matchesSearch = fuzzyMatch(searchText, searchQuery);
        }

        let matchesTags = true;
        if (activeTags.size > 0 && tagsAttr) {
          const itemTags: string[] = JSON.parse(tagsAttr);
          matchesTags = itemTags.some((tag) => activeTags.has(tag));
        } else if (activeTags.size > 0) {
          matchesTags = false;
        }

        const shouldShow = matchesSearch && matchesTags;
        item.style.display = shouldShow ? '' : 'none';
        if (shouldShow) visibleCount++;
      });

      const yearHeader = section.querySelector<HTMLElement>('.year-header');
      if (yearHeader) {
        yearHeader.style.display = visibleCount > 0 ? '' : 'none';
      }

      section.style.display = visibleCount > 0 ? '' : 'none';

      updateSeparators(section);
    });
  }

  function updateSeparators(section: HTMLElement) {
    const items = section.querySelectorAll<HTMLElement>('li');
    if (!items) return;

    items.forEach((item, index) => {
      if (!item.classList.contains('separator')) return;

      const prevItem = items[index - 1];
      const nextItem = items[index + 1];

      if (!prevItem || !nextItem || 
          prevItem.style.display === 'none' || 
          nextItem.style.display === 'none') {
        item.classList.add('hidden');
      } else {
        item.classList.remove('hidden');
      }
    });
  }

  function updateUI() {
    if (!filterCount) return;
    if (activeTags.size > 0) {
      filterCount.classList.remove('hidden');
      filterCount.textContent = activeTags.size.toString();
    } else {
      filterCount.classList.add('hidden');
    }
  }
});
</script>
